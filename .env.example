# The TypeScript CLI loads this file. Enable exactly one provider API key.
# Anthropic is shown as the default.
ANTHROPIC_API_KEY=replace-with-your-api-key
# OPENAI_API_KEY=replace-with-your-api-key
# GEMINI_API_KEY=replace-with-your-api-key

# Required: model identifier exposed by the selected provider.
MODEL_ID=replace-with-your-model-id

# Optional: set only the base URL for the selected provider.
ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
# GEMINI_BASE_URL=
